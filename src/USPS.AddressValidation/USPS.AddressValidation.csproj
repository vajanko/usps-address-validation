<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- NuGet package identity. -->
  <PropertyGroup>
    <PackageId>USPS.AddressValidation</PackageId>
    <Title>USPS Address Validation</Title>
    <!--
      Local default only. The release pipeline overrides this with the version from the git tag:
      `dotnet pack -p:Version=1.2.3`. Do not bump it by hand to cut a release - push a tag.
    -->
    <Version>1.0.0</Version>
    <Authors>CDB</Authors>
    <Company>CDB</Company>
    <Copyright>Copyright (c) 2026 CDB</Copyright>
    <!-- Kept on one line: NuGet renders the description verbatim, newlines and all. -->
    <Description>Reusable .NET client for USA address validation via the USPS Addresses 3.0 API, using OAuth 2.0 client credentials. Returns a standardized address with the fields USPS corrected or completed, reports addresses USPS cannot validate as results rather than exceptions, and throws only when the request itself fails.</Description>
    <PackageTags>usps;address;validation;address-verification;address-standardization;zip;zip4;usa</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!--
      Placeholders: set these to your GitHub repository. The CI workflow overrides both from the
      GitHub Actions context, so a tagged release always carries the correct URLs even if these
      are left as they are.
    -->
    <RepositoryUrl>https://github.com/OWNER/REPO</RepositoryUrl>
    <PackageProjectUrl>https://github.com/OWNER/REPO</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>See https://github.com/OWNER/REPO/releases</PackageReleaseNotes>
  </PropertyGroup>

  <!-- Reproducible, debuggable packages. SourceLink for GitHub ships in the .NET SDK. -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <!-- Normalizes file paths in the PDB. Set by the workflow; also honoured for any CI build. -->
    <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == '' AND '$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Condition="Exists('..\..\LICENSE')" />
    <InternalsVisibleTo Include="USPS.Tests" />
  </ItemGroup>

</Project>
